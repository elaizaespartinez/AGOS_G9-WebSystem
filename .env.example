GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

PROVIDER_ORDER=groq,gemini,openrouter
HOTLINE_PLACEHOLDER=your local DRRM hotline
PORT=3001
CORS_ORIGIN=http://localhost:5173
PROVIDER_TIMEOUT_MS=8000

# Used by the server to verify Supabase bearer tokens and administrator roles.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Prefer a server-only service role key when profile RLS prevents role lookup.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key